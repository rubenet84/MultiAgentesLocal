# =============================================================
# CONFIGURACIÓN - MULTIAGENTESLOCAL
# =============================================================
# Copia este archivo como .env y personaliza los valores
# NO INCLUYAS este archivo en git (agrégalo a .gitignore)
# 
# Documentación: https://github.com/tu-repo/README.md
# =============================================================

# ==================== LANGSMITH (MONITOREO) ====================
# Habilita el rastreo de ejecuciones en LangSmith Dashboard
# Valores: true | false
LANGCHAIN_TRACING_V2=false

# API Key de LangSmith
# Obtén una en: https://smith.langchain.com
# Déjalo vacío si LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Nombre del proyecto en LangSmith Dashboard
LANGCHAIN_PROJECT=MultiAgentesLocal

# ==================== OLLAMA (IA LOCAL) ====================
# URL base del servidor Ollama (por defecto: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo a utilizar
# Opciones recomendadas:
#   - qwen2.5-coder:latest  (14GB) - Excelente para código
#   - deepseek-coder:latest (9GB)  - Muy bueno para programación
#   - mistral:latest        (4GB)  - Rápido y ligero
#   - neural-chat:latest    (5GB)  - Balanceado
OLLAMA_MODEL=qwen2.5-coder:7b

# ==================== LOGGING ====================
# Nivel de log
# Valores: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Modo verbose (salida detallada de agentes)
# Valores: true | false
VERBOSE_MODE=true

# ==================== VERSIÓN ====================
APP_VERSION=1.0.0